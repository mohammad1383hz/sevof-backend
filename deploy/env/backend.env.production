# Sevof backend production .env  ->  /var/www/sevof-backend/.env  (owner www-data, mode 640)
# Fill every value marked <...>. Never copy seobot's .env: it points at seobot's database.

APP_NAME=Sevof
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.sevof.com
FRONT_URL=https://app.sevof.com
FRONTEND_URL=https://app.sevof.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Daily files, 14 days; "warning" keeps the disk small and keeps request details out of the logs.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Own database and user (see DEPLOY.md step 3).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sevof
DB_USERNAME=sevof
DB_PASSWORD=<sevof DB password>

# Redis is shared with seobot: Sevof uses DB 2 (queues) and DB 3 (cache) with its own prefixes.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<same REDIS_PASSWORD as /var/www/seobot-back/.env>
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_PREFIX=sevof_database_
CACHE_STORE=redis
CACHE_PREFIX=sevof_cache_
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Horizon: own Redis prefix and small worker counts for this 1-CPU / 2 GB server.
HORIZON_NAME=Sevof
HORIZON_PREFIX=sevof_horizon:
HORIZON_DEFAULT_MIN=1
HORIZON_DEFAULT_MAX=2
HORIZON_BACKGROUND_MAX=1
HORIZON_PRODUCTS_PROCESSES=1

SANCTUM_STATEFUL_DOMAINS=app.sevof.com
SESSION_DOMAIN=null

# Mail through the local Postfix (needs SPF + DKIM for sevof.com, see DEPLOY.md).
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@sevof.com
MAIL_FROM_NAME=Sevof

# OpenAI (chat keys also live in the `gapgpt` table, see DEPLOY.md step 6).
OPENAI_API_KEY=<sk-...>
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_IMAGE_API_KEY=

# Stripe (USD). Webhook endpoint: https://api.sevof.com/api/v1/payments/stripe/webhook
STRIPE_SECRET=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
STRIPE_CURRENCY=usd

# Google sign-in (Sevof's own OAuth client, same ID as the front's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-...>

# Google Search Console. Authorized redirect URI in Google Cloud must be exactly this:
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=<GOCSPX-...>
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=https://api.sevof.com/api/v1/google-search-console/callback

# Shopify app (Partner dashboard): App URL https://api.sevof.com/api/v1/shopify/entry,
# redirect https://api.sevof.com/api/v1/shopify/callback, webhooks https://api.sevof.com/api/shopify/webhooks
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

JUSTSERP_API_KEY=

# Keyword scraper (own Python venv inside this project).
KWSCRAPER_VENV_PYTHON=/var/www/sevof-backend/seo-keyword-scraper/.venv/bin/python
KWSCRAPER_PROJECT_PATH=/var/www/sevof-backend/seo-keyword-scraper
KWSCRAPER_LANG=en
KWSCRAPER_COUNTRY=US
KWSCRAPER_TIMEOUT=30

WP_AGENT_REQUEST_TIMEOUT=20
