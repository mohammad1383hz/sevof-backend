# Sevof front build env -> E:\backup\front-univeciry\seobot-national\.env before `npm run build`.
# Vite bakes these into the JS bundle at build time; they are public values, never put secrets here.
VITE_API_BASE_URL=https://api.sevof.com
VITE_UPLOADS_URL=https://api.sevof.com
VITE_GOOGLE_CLIENT_ID=<same value as GOOGLE_CLIENT_ID in the backend .env>
VITE_WP_PLUGIN_PAGE_URL=
